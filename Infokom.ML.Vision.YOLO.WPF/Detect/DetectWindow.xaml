<Window x:Class="Infokom.ML.Vision.YOLO.WPF.Detect.DetectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Infokom.ML.Vision.YOLO.WPF.Detect"
        mc:Ignorable="d"
        Title="DetectWindow" Height="675" Width="1200">

	<Window.DataContext>
		<local:DetectViewModel></local:DetectViewModel>
	</Window.DataContext>
	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Margin" Value="5"></Setter>
			<Setter Property="Padding" Value="3"></Setter>
			<Setter Property="Width" Value="110"></Setter>
		</Style>

		<Style TargetType="RadioButton">
			<Setter Property="Margin" Value="5"></Setter>
			<Setter Property="Padding" Value="3"></Setter>
		</Style>
	</Window.Resources>
	<DockPanel LastChildFill="True">
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
			<GroupBox Header="Model Size" Margin="5">
				<UniformGrid Columns="5" Margin="5">
					<RadioButton>Nano</RadioButton>
					<RadioButton>Small</RadioButton>
					<RadioButton>Medium</RadioButton>
					<RadioButton>Large</RadioButton>
					<RadioButton>XLarge</RadioButton>
				</UniformGrid>
			</GroupBox>

			<GroupBox Header="Stream Controls" Margin="5" >
				<UniformGrid Columns="3">
					<Button x:Name="ButtonPlay" Click="ButtonPlay_Click">Play</Button>
					<Button x:Name="ButtonPause">Pause</Button>
					<Button x:Name="ButtonStop">Stop</Button>
				</UniformGrid>
			</GroupBox>
		</StackPanel>

		<UniformGrid>

		</UniformGrid>

	</DockPanel>
</Window>
